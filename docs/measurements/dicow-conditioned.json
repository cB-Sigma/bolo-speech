{
 "what": "Diarization-conditioned recognition in bolo: BUT-FIT DiCoW v3.3 and SE-DiCoW in the bolo-torch plugin (plugin request 'speakers'), against bolo's turn-by-turn diarized transcription; plus a check of the plugin's conditioning against BUT's reference inference pipeline",
 "date": "2026-11-14",
 "conditions": "4 vCPU Xeon @ 2.1 GHz with AMX / AVX512-BF16, no GPU; bolo's models and the plugin at 2 threads; DiCoW in bfloat16 (the plugin's default on such CPUs); torch 2.15.0+cpu, transformers 4.55.0, Python 3.12 (plugin), bolo's own venv for the server (onnxruntime 1.31.1, sherpa-onnx 2.0.1). Accuracy runs partly overlapped with other evaluation jobs of this study; speeds come from a separate run on the idle machine",
 "models": {
  "dicow-v3.3": "BUT-FIT/DiCoW_v3_3@c34b64d9a9c5148c65fd355bb188d60343a6b44f (model.safetensors sha256 73dee45746bb4a6e...)",
  "se-dicow": "BUT-FIT/SE-DiCoW@470fce9ffff844dd53a27751cdf6c6df9efecb39",
  "diarizers": "nemotron-3-diarization as shipped (threshold 0.5, gaps under 1 s closed); pyannote-3.0-eres2net defaults",
  "baseline_recogniser": "whisper-base (sherpa-onnx int8); faster-whisper-tiny-hindi for the Hindi pair"
 },
 "systems": {
  "b0": "pyannote-3.0-eres2net + whisper-base (bolo default, turn by turn)",
  "d1": "nemotron-3-diarization + whisper-base (turn by turn)",
  "t1": "nemotron-3-diarization + dicow-v3.3 (conditioned on the turns)",
  "t1p": "nemotron-3-diarization + dicow-v3.3 (conditioned on Nemotron's probabilities)",
  "t1b": "pyannote-3.0-eres2net + dicow-v3.3 (conditioned on the clustering turns)",
  "t2": "nemotron-3-diarization + se-dicow (conditioned on the turns)"
 },
 "data": {
  "ami": "the 24 AMI SDM (Array1-01) excerpts of 45 s of docs/measurements/diarization-nemotron.json (test meetings ES2004a, IS1009a, TS3003a, EN2002a; 12-65 % overlap; CC BY 4.0), re-cut from the meetings",
  "synthetic": "bolo's 44 two-voice mixes (11 voice pairs: 4 cross-gender English, 3 same-gender female, 3 same-gender male, 1 Hindi; 2.5 s and 5 s overlap at 0 dB; 16 kHz and 8 kHz G.711 mu-law), rebuilt with the same texts, voices and layout (Kokoro TTS is not bit-exact between runs), every system run on exactly these files"
 },
 "scoring": "MeetEval 0.4.3 cp_word_error_rate, Whisper EnglishTextNormalizer after html.unescape for every system (Hindi: NFC, punctuation removed), pooled over files; relative change and 95 % interval by paired bootstrap over files (2000 resamples). tcpWER: MeetEval tcpwer, collar 5 s, AMI word times as reference. The 'rtf' values inside the cpwer_* sections come from the accuracy runs (some overlapped other jobs and include the first model load); the speed_* sections are the timing figures",
 "validation_against_reference": {
  "reference": "BUTSpeechFIT/DiCoW pipeline.py (main, fetched 2026-11-13): get_diarization_mask, get_stno_mask, _process_enrollment_sample, then model.generate on the same features (long-form, return_timestamps) and tokenizer.batch_decode",
  "input": "Nemotron turns of ES2004a_00355 (4 speakers) and IS1009a_00275 (2 speakers)",
  "dicow-v3.3": {
   "mask_values_differing": 0,
   "mask_frames_compared": 13500,
   "speaker_streams_identical": "6 of 6"
  },
  "se-dicow": {
   "mask_values_differing": 0,
   "enrolment_windows_identical": "6 of 6",
   "speaker_streams_identical": "6 of 6"
  },
  "note": "a first version put the turns on a 10 ms grid: 6 and 22 mask frames differed by one 20 ms frame at turn edges and 2 of 6 speaker transcripts differed slightly; the shipped 20 ms grid with the reference's rounding (t * 50) makes them identical"
 },
