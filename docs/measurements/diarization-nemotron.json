 },
 "data": {
  "ami": "24 excerpts of 45 s, AMI SDM (Array1-01) test meetings ES2004a, IS1009a, TS3003a, EN2002a, chosen for overlap (12-65 %), CC BY 4.0; references: word times with gaps under 0.3 s joined ('words'), and the manual segments ('segments')",
  "synthetic": "bolo's two-voice mixes (Kokoro / Piper TTS): pairs 0-3 cross-gender English, 6-8 same-gender female, 9-11 same-gender male, 12 Hindi; overlap 2.5 s and 5 s at 0 dB; each also 300-3400 Hz, 8 kHz G.711 mu-law: 44 mixes; reference = utterance boundaries",
  "long": "two 270 s recordings, the six excerpts of ES2004a and of TS3003a joined",
  "dialogues": "32 four-line two-voice dialogues of Kokoro voices (about 16 s, 0.6 s pauses, no overlap); DER with bolo's frame scorer"
 },
 "scoring": "DER: pyannote.metrics 4.0, collar 0, overlap scored, pooled over files (percent). cpWER: MeetEval 0.4.3 cp_word_error_rate, Whisper EnglishTextNormalizer after html.unescape (Hindi: NFC, punctuation removed), pooled; relative change and 95 % interval by paired bootstrap over files (2000 resamples)",
