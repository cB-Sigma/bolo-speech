{
  "name": "bolo-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check .",
    "dev:mock": "vite --mode mock",
    "build:mock": "vite build --mode mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "screenshots": "node scripts/screenshots.mjs",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "serve:demo": "node scripts/serve-pages.mjs",
    "e2e:demo": "playwright test --config playwright.demo.config.ts --trace off"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-gujarati": "^5.3.0",
    "@fontsource-variable/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource-variable/noto-sans-kannada": "^5.3.0",
    "@fontsource-variable/noto-sans-malayalam": "^5.3.0",
    "@fontsource-variable/noto-sans-oriya": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0"
}
